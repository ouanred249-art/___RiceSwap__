# Maintainer: the RiceSwap project
#
# Development build of RiceSwap: tracks the default branch HEAD with the AUR
# git helper and installs the same five artifacts as the other two packages
# in the trio. Never writes to $HOME or hyprland.conf.

pkgname=riceswap-git
pkgver=r999.master
pkgrel=1
pkgdesc="Profile-based rice switcher for Hyprland (Quickshell GUI + Rust backend, bleeding edge)"
arch=(x86_64)
url="https://github.com/ouanred249-art/___RiceSwap__"
license=(MIT)

depends=(quickshell hyprland grim pacman)
makedepends=(rust cargo)
optdepends=(
    "yay: AUR helper (auto-detected, preferred over paru)"
    "paru: AUR helper (fallback when yay is absent)"
    "polkit: polkit agent for the system password dialog on package ops"
)
source=("git+https://github.com/ouanred249-art/___RiceSwap__#branch=main")
sha256sums=('SKIP')

build() {
    cd "$srcdir/___RiceSwap__"
    cargo build --release
}

# GNU `install` has no -r flag (that's BSD's): copy the whole tree, then
# normalize file modes to data-file permissions. Same layout install.sh uses.
_install_tree() {
    local src="$1" dest="$2"
    install -d -m755 "$dest"
    cp -a -- "$src/." "$dest/"
    find "$dest" -type f -exec chmod 644 {} +
}

package() {
    cd "$srcdir/___RiceSwap__"

    # Backend binary (freshly compiled from HEAD) → /usr/bin
    install -Dm755 "target/release/riceswap" "${pkgdir}/usr/bin/riceswap"

    # Floating-terminal wrapper (AUR-helper transactions) → /usr/bin
    install -Dm755 "scripts/riceswap-float" "${pkgdir}/usr/bin/riceswap-float"

    # GUI config → /etc/xdg/quickshell/riceswap/
    _install_tree gui "${pkgdir}/etc/xdg/quickshell/riceswap"

    # Bundled wallpapers → /usr/share/riceswap/wallpapers/
    _install_tree assets/wallpapers "${pkgdir}/usr/share/riceswap/wallpapers"

    # Keybind snippet as a data file → /usr/share/riceswap/
    install -Dm644 "share/riceswap-keybinds.conf" \
        "${pkgdir}/usr/share/riceswap/riceswap-keybinds.conf"
}
